{
  "type": "Menu",
  "title": {
    "name": "『Settings』",
    "size": 15,
    "elevation": 3,
    "background": "$menu_title_background_color",
    "padding": [
      4,
      4,
      4,
      4
    ],
    "colors": [
      "$menu_title_gradient_text_begin_color",
      "$menu_title_gradient_text_end_color"
    ],
    "margins": [
      0,
      0,
      0,
      0
    ]
  },
  "color": "$menu_color",
  "alpha": 0.85,
  "can_close": true,
  "hide": true,
  "margins": [
    0,
    0,
    0,
    0
  ],
  "image_scaled_size": 40,
  "radius": 10,
  "show_dividers": false,
  "items": [
    {
      "type": "Switch",
      "name": "显示水印",
      "color": "$menu_item_color",
      "tag": "fun_watermark",
      "bind_keys": [
        "P"
      ],
      "items": [
        {
          "type": "SeekBar",
          "key": "rotation",
          "format": "旋转角度%.2f",
          "color": "$menu_item_color",
          "value": -30.0,
          "min": -180.0,
          "max": 188.0,
          "size": 8,
          "padding": [
            0,
            0,
            0,
            0
          ]
        },
        {
          "type": "SeekBar",
          "key": "size",
          "format": "文本大小%.2f",
          "color": "$menu_item_color",
          "value": 70.0,
          "min": 10.0,
          "max": 100.0,
          "size": 8,
          "padding": [
            0,
            0,
            0,
            0
          ]
        },
        {
          "type": "SeekBar",
          "key": "alpha",
          "format": "透明度%d",
          "color": "$menu_item_color",
          "value": 76,
          "min": 0,
          "max": 255,
          "size": 8,
          "padding": [
            0,
            0,
            0,
            0
          ]
        },
        {
          "type": "ColorPicker",
          "key": "color",
          "name": "自定义颜色",
          "color": "$menu_item_color",
          "default_color": -65281,
          "ok": "确定",
          "cancel": "取消"
        }
      ],
      "size": 12,
      "padding": [
        5,
        0,
        5,
        0
      ],
      "shortcut": {
        "type": "CheckedButton",
        "params": [
          65,
          65
        ],
        "no_circle": true,
        "off": "close/NeuronOff_WaterMark.png",
        "on": "open/NeuronOn_WaterMark.png",
        "icon": "open/NeuronOn_WaterMark.png"
      }
    },
    {
      "type": "Switch",
      "name": "加入游戏自动复制地址",
      "color": "$menu_item_color",
      "size": 12,
      "padding": [
        5,
        5,
        5,
        5
      ],
      "shortcut": {
        "type": "CheckedButton",
        "params": [
          65,
          65
        ],
        "no_circle": true,
        "off": "close/NeuronOff_CopyAddress.png",
        "on": "open/NeuronOn_CopyAddress.png",
        "icon": "open/NeuronOn_CopyAddress.png"
      },
      "tag": "fun_join_copy_address"
    },
    {
      "type": "Switch",
      "name": "悬浮窗口半屏显示",
      "color": "$menu_item_color",
      "register_setting": "setting_window_cut",
      "size": 12,
      "padding": [
        5,
        0,
        5,
        0
      ]
    },
    {
      "type": "Switch",
      "name": "隐藏菜单快捷按钮(长按)",
      "color": "$menu_item_color",
      "tag": "fun_hide_menu_shortcut",
      "shortcut": {
        "type": "CheckedButton",
        "params": [
          65,
          65
        ],
        "no_circle": true,
        "off": "close/NeuronOff_HideMenu.png",
        "on": "open/NeuronOn_HideMenu.png",
        "icon": "open/NeuronOn_HideMenu.png"
      },
      "size": 12,
      "padding": [
        5,
        0,
        5,
        0
      ]
    },
    {
      "type": "TextView",
      "name": "关于",
      "color": "$menu_item_color",
      "margins": 7,
      "padding": 5,
      "open": "Neuron_about",
      "size": 12
    },
    {
      "type": "TextView",
      "name": "删除游戏数据",
      "color": "$menu_item_set_color",
      "margins": 7,
      "padding": 5,
      "tag": "fun_delete_app_data",
      "size": 12,
      "shortcut": {
        "type": "ClickButton",
        "params": [
          65,
          65
        ],
        "no_circle": true,
        "icon": "other/Neuron_DeleteAppData.png"
      }
    },
    {
      "type": "TextView",
      "name": "删除用户数据",
